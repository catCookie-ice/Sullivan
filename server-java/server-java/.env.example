# 复制为 .env 后填写本地值。.env 不入库；全部可配置项见 src/main/resources/application.example.properties。

# 可选：覆盖 application.properties 中的服务端口（默认 8080）
# SERVER_PORT=8080

# 可选：运行环境 dev（开发，默认）/ prod（生产）。dev 提供 /dev/routes 路由查看接口。
# APP_ENV=dev

DB_USERNAME=root
DB_PASSWORD=change_me_mysql_password
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes
BOOTSTRAP_ADMIN_LOGIN=superadmin
BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_password_at_least_12_chars
BOOTSTRAP_ADMIN_DISPLAY_NAME=初始最高管理员

# 志愿者兼任申请：注册满 N 天（默认 90 天 = 3 个月）才可申请/审核通过
# VOLUNTEER_MIN_REGISTRATION_DAYS=90

# 可选：高德「Web 服务」Key（报警坐标 → 地名）。留空 = 功能关闭，报警不受影响。
# 注意是 Web 服务类型，与 Android 客户端在用的 Android 平台 Key 不是同一种。
# AMAP_WEB_KEY=
# 可选：解析硬时限（毫秒，默认 1000）。到点没解析完就带 pending 标识直接转发报警。
# AMAP_GEOCODE_DEADLINE_MS=1000

# 可选：Redis（管理员注册码缓存与原子核销）。默认 127.0.0.1:6379 无密码。
# 与本机 docker-compose 的 sullivan-redis 保持一致（REDIS_PASSWORD 见仓库根 .env）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# 媒体对象存储：filesystem（开发默认，不配凭据也能跑）| cos（腾讯云，部署用）| minio（自建）
# 注意：留空（KEY=）会覆盖成空串而非回退默认值，用不到的请整行注释掉。
# MEDIA_STORE=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=
# COS_BUCKET=
# COS_PREFIX=
