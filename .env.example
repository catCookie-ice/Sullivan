# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不要提交。

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_USER=sullivan
MYSQL_APP_PASSWORD=change_me_app
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=sullivan
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT —— 生产环境必须换成足够长的随机值
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_DAYS=30

# 导航服务
NAV_MODEL_PATH=/models/yolov8n-seg.onnx
NAV_DEVICE=cuda
NAV_PRECISION=fp16

# 志愿者兼任申请：注册满 N 天（默认 90 天 = 3 个月）才可申请/审核通过
VOLUNTEER_MIN_REGISTRATION_DAYS=90
