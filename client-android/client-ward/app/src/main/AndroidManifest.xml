<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 剧烈晃动报警的振动提示（PromptAnnouncer） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 受护人端侧检测依赖后置摄像头 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <!-- 陀螺仪**不是**必需：缺失时报警功能关闭并提示一次，其余功能照常 -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <application
        android:name=".SullivanApp"
        android:label="Sullivan"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sullivan"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic：后端是 http://<局域网IP>:8642，没有 TLS。
            不开这一项，Android 9+ 会直接掐掉所有明文请求。
            这是**已知风险**而非疏漏：明文下登录密码、二维码票据与最终令牌
            对同网段任何人都可见。详见 docs/final/17-开发日记-2026-10-16.md。
        -->

        <!-- 三角色入口：受护人 / 监护人 / 志愿者 -->
        <activity
            android:name=".ui.roleentry.RoleEntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 监护人账密登录。扫码授权要求监护人已登录，所以这一步不能也用扫码。 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 受护人扫码登录：出示登录二维码并轮询，换到令牌即进入受护人主页。 -->
        <activity
            android:name=".ui.login.QrLoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait" />

        <!--
            受护人主页：端侧障碍检测。
            必须锁竖屏且声明 configChanges —— 旋转会重建 Activity 从而拆掉 CameraX 绑定，
            而预览画面与叠加层的坐标换算都假设画面几何在 Activity 生命周期内不变。
        -->
        <activity
            android:name=".ui.protectee.home.ProtecteeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sullivan.Camera" />

        <!-- 受护人「我的绑定码」：登录后才可以进，展示绑定二维码 + 可朗读的短码。 -->
        <activity
            android:name=".ui.protectee.binding.BindCodeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 监护人主页：扫码绑定 / 扫受护人登录码 / 已绑定受护人列表。 -->
        <activity android:name=".ui.guardian.home.GuardianActivity" />

        <!-- 通用扫码页：不透明全屏主题；自己申请 CAMERA 权限（监护人可能是全新安装）。 -->
        <activity
            android:name=".ui.common.scan.QrScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sullivan.Camera" />

        <!--
            志愿者主页**不在这里声明**：该界面尚未实现，RoleEntryActivity 对志愿者入口
            弹的是「尚未实现」提示。声明一个指向不存在类的 Activity 不会让构建失败
            （manifest 不校验类是否存在），但会留下一个点了就崩的入口。
        -->

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />
    </application>
</manifest>
