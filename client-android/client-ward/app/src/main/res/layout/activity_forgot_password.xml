<?xml version="1.0" encoding="utf-8"?>
<!--
    找回密码（三步向导，与 web 的 ForgotPasswordView 同构）。

    <b>这不是「重设密码」，是「验证你还认识这个账号」</b>：后端没有重置密码的接口，
    web 端走到最后一步只显示一句「重置密码功能正在开发中，后续将开放」。
    安卓端照搬这个口径 —— 最后一步必须如实说「密码没有变」，
    否则用户会以为已经改好了，回去拿旧密码登录失败，再怀疑是自己记错了。

    三个步骤是三个 LinearLayout，靠 visibility 切换，不做 ViewPager：
    步骤之间有前后依赖（第 2 步的选项来自第 1 步的响应），
    横滑反而让人以为可以跳过前面的步骤。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/an_flourish_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sullivan.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/forgot_title"
                    android:textAppearance="@style/TextAppearance.Sullivan.Display" />

                <TextView
                    android:id="@+id/forgot_step_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/forgot_subtitle"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body"
                    tools:text="输入登录名，看看当初设过哪种找回方式。" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/an_space_m"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_divider_vine" />

        <!-- ===== 第一步：登录名 ===== -->
        <LinearLayout
            android:id="@+id/forgot_step_one"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Sullivan.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/forgot_field_login">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/forgot_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/an_ink"
                    android:textSize="@dimen/an_text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/forgot_next"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_l"
                android:text="@string/forgot_action_next" />
        </LinearLayout>

        <!-- ===== 第二步：选方式并补全 ===== -->
        <LinearLayout
            android:id="@+id/forgot_step_two"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forgot_pick_method"
                android:textAppearance="@style/TextAppearance.Sullivan.Section" />

            <RadioGroup
                android:id="@+id/forgot_methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/forgot_method_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/forgot_no_methods"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption"
                tools:text="请把 11 位手机号完整填一遍" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/forgot_contact_wrap"
                style="@style/Widget.Sullivan.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:hint="@string/forgot_field_complete_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/forgot_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:textColor="@color/an_ink"
                    android:textSize="@dimen/an_text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/forgot_verify"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_l"
                android:text="@string/forgot_action_verify" />

            <Button
                android:id="@+id/forgot_restart"
                style="@style/Widget.Sullivan.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/forgot_action_restart" />
        </LinearLayout>

        <!-- ===== 第三步：结果 ===== -->
        <LinearLayout
            android:id="@+id/forgot_step_three"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/forgot_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/forgot_verified"
                android:textAppearance="@style/TextAppearance.Sullivan.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/forgot_verified_note"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />

            <Button
                android:id="@+id/forgot_back_login"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_l"
                android:text="@string/forgot_action_back_login" />
        </LinearLayout>

        <TextView
            android:id="@+id/forgot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_m"
            android:textColor="@color/an_gold_deep"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="查找中…"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
