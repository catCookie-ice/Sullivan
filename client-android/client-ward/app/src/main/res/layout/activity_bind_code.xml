<?xml version="1.0" encoding="utf-8"?>
<!--
    受护人「我的绑定码」。

    这一页是给**受护人自己看的**，所以：
    - 白底黑字、字号偏大（低视力）；
    - 二维码本身标记为无障碍不可见，旁边配一个可朗读的短码 + 「朗读绑定码」按钮 ——
      二维码对看不见屏幕的人零信息量，短码才是他能说给监护人听的东西；
    - 短码按 4 位分组显示（K7M2 XQ9T B4ND），朗读和手抄都少出错。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    tools:context=".ui.protectee.binding.BindCodeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bindcode_title"
            android:textColor="@android:color/black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bindcode_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF444444"
            android:textSize="17sp"
            tools:text="受护人：王小明" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/bindcode_hint"
            android:textColor="#FF444444"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/bindcode_image"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/white"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/bindcode_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/bindcode_loading"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <!-- 可朗读的短码：大字号 + 字距拉开，读起来和抄起来都清楚 -->
        <TextView
            android:id="@+id/bindcode_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:textColor="@android:color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="K7M2 XQ9T B4ND" />

        <TextView
            android:id="@+id/bindcode_ttl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FF666666"
            android:textSize="15sp"
            tools:text="118 秒后失效，过期会自动换一张" />

        <Button
            android:id="@+id/bindcode_speak"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="@string/bindcode_speak"
            android:textSize="20sp" />

        <Button
            android:id="@+id/bindcode_refresh"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/bindcode_refresh"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
