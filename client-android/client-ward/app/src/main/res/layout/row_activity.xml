<?xml version="1.0" encoding="utf-8"?>
<!--
    公益活动列表的一行。

    字段顺序按「决定要不要去」的优先级排：活动名 → 时间 → 地点 → 机构 → 名额。
    机构放在地点后面，因为用户是照着地点找活动，不是照着机构找。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/an_space_m"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/activity_status"
            style="@style/Widget.Sullivan.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/an_chip_neutral"
            android:textAppearance="@style/TextAppearance.Sullivan.Caption"
            tools:text="招募中" />

        <TextView
            android:id="@+id/activity_quota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/an_space_s"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Sullivan.Caption"
            tools:text="已报名 3 / 20" />
    </LinearLayout>

    <TextView
        android:id="@+id/activity_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:textAppearance="@style/TextAppearance.Sullivan.Title"
        tools:text="徒步陪伴" />

    <TextView
        android:id="@+id/activity_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_xs"
        android:textAppearance="@style/TextAppearance.Sullivan.Caption"
        tools:text="2026-09-01 09:00 ~ 12:00" />

    <TextView
        android:id="@+id/activity_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_xs"
        android:textAppearance="@style/TextAppearance.Sullivan.Body"
        tools:text="朝阳公园南门" />

    <TextView
        android:id="@+id/activity_org"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_xs"
        android:textAppearance="@style/TextAppearance.Sullivan.Caption"
        tools:text="朝阳盲协" />

    <TextView
        android:id="@+id/activity_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:textAppearance="@style/TextAppearance.Sullivan.Body"
        android:visibility="gone"
        tools:text="2 公里，沿途有志愿者引导"
        tools:visibility="visible" />

</LinearLayout>
