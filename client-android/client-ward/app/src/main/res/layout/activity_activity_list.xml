<?xml version="1.0" encoding="utf-8"?>
<!--
    公益活动列表（只读浏览，监护人与志愿者共用）。

    <b>筛选是一排可点的小卡片，不是下拉框</b>：只有五个选项（全部 + 四个状态），
    排成一行一眼能看完；下拉框要点两下，而且在手机上下拉弹层会把列表盖住，
    用户看不到「换了个筛选之后还剩几条」。

    <b>分页用「加载更多」而不是页码</b>：服务端的页码是 1 起、每页 20 条，
    而手机上的列表是连续滚动的 —— 给页码就得让用户在滚动与点页码之间来回切。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/an_bg_page"
    android:orientation="vertical"
    tools:context=".ui.common.activity.ActivityListActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/an_space_l"
        android:paddingTop="@dimen/an_space_xl"
        android:paddingEnd="@dimen/an_space_l">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/an_flourish_corner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Sullivan.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_xs"
                android:text="@string/activity_title"
                android:textAppearance="@style/TextAppearance.Sullivan.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/activity_subtitle"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_m"
        android:paddingStart="@dimen/an_space_l"
        android:paddingEnd="@dimen/an_space_l"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/activity_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/activity_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/an_space_l"
        android:layout_marginTop="@dimen/an_space_s"
        android:layout_marginEnd="@dimen/an_space_l"
        android:textAppearance="@style/TextAppearance.Sullivan.Caption"
        android:visibility="gone"
        tools:text="共 3 个活动"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/an_space_l"
            android:paddingEnd="@dimen/an_space_l"
            android:paddingBottom="@dimen/an_space_l"
            tools:listitem="@layout/row_activity" />

        <com.sullivan.android.ui.common.components.StateView
            android:id="@+id/activity_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <Button
        android:id="@+id/activity_more"
        style="@style/Widget.Sullivan.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/an_button_height"
        android:layout_marginStart="@dimen/an_space_l"
        android:layout_marginEnd="@dimen/an_space_l"
        android:layout_marginBottom="@dimen/an_space_l"
        android:text="@string/activity_action_more"
        android:visibility="gone" />
</LinearLayout>
