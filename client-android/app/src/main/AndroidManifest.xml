<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SullivanApp"
        android:label="Sullivan"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sullivan">

        <!-- 三角色入口：受护人 / 监护人 / 志愿者 -->
        <activity
            android:name=".ui.roleentry.RoleEntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录 -->
        <activity android:name=".ui.login.LoginActivity" />

        <!-- 受护人主页 -->
        <activity android:name=".ui.protectee.home.ProtecteeActivity" />

        <!-- 监护人主页 -->
        <activity android:name=".ui.guardian.home.GuardianActivity" />

        <!-- 志愿者主页 -->
        <activity android:name=".ui.volunteer.home.VolunteerActivity" />

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />
    </application>
</manifest>
