<?xml version="1.0" encoding="utf-8"?>
<!--
    实时会话：发起 / 接听 / 挂断，以及通话画面与文字中继。

    <b>为什么要选人而不是填账号</b>：手机上用户心里的对象是「跟谁说」，不是一串编号。
    候选来自已绑定的关系，选中的那一个再换回 uid 提交 —— 界面从头到尾不出现 uid。

    <b>为什么通话画面放在这一页而不是另开一个全屏页</b>：会话是「当面用一下」的短时动作，
    另开一页意味着挂断时还要退回来，多一次返回、多一个可能卡住的中间态。
    一页里从上到下就是「谁 → 什么类型 → 通话 → 挂断」，逻辑顺序与手指顺序一致。

    整页放在一个 ScrollView 里：会话最多几条，通话画面高度固定，不会把内容顶出去。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/session_page"
    style="@style/Widget.Sullivan.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.common.realtime.RealtimeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/an_flourish_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sullivan.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/session_title"
                    android:textAppearance="@style/TextAppearance.Sullivan.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/session_subtitle"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/an_space_m"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_divider_vine" />

        <!-- ===== 发起会话 ===== -->
        <LinearLayout
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/session_create_title"
                android:textAppearance="@style/TextAppearance.Sullivan.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_xs"
                android:text="@string/session_create_field"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption" />

            <Spinner
                android:id="@+id/session_target"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_touch_min"
                android:layout_marginTop="@dimen/an_space_s"
                android:contentDescription="@string/session_create_field"
                android:spinnerMode="dialog" />

            <TextView
                android:id="@+id/session_target_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/session_create_no_contact"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption"
                android:visibility="gone"
                tools:text="@string/session_create_no_contact"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:text="@string/session_type_label"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption" />

            <RadioGroup
                android:id="@+id/session_types"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/session_type_voice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/an_touch_min"
                    android:text="@string/session_type_voice" />

                <RadioButton
                    android:id="@+id/session_type_video"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/an_touch_min"
                    android:text="@string/session_type_video" />

                <RadioButton
                    android:id="@+id/session_type_camera"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/an_touch_min"
                    android:text="@string/session_type_camera" />
            </RadioGroup>

            <Button
                android:id="@+id/session_create"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_m"
                android:text="@string/session_action_create" />

            <TextView
                android:id="@+id/session_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="已呼叫张三，等待对方接听…"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- ===== 会话列表 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_xl"
            android:text="@string/session_list_title"
            android:textAppearance="@style/TextAppearance.Sullivan.Section" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/an_space_s"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_section_rule" />

        <Button
            android:id="@+id/session_refresh"
            style="@style/Widget.Sullivan.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginTop="@dimen/an_space_xs"
            android:text="@string/session_action_refresh" />

        <com.sullivan.protectee.ui.common.components.StateView
            android:id="@+id/session_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/session_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ===== 通话与文字中继 ===== -->
        <LinearLayout
            android:id="@+id/session_chat"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/session_chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sullivan.Section"
                tools:text="已接通 · 与张三的会话" />


            <!--
              远端画面。只在视频/摄像头会话里出现（代码里切换 visibility）。

              SurfaceViewRenderer 必须由代码 init()，且挂载期间不能和别的渲染器共用
              同一个 EglBase —— 所以这里只声明一个，不预留"画中画"的小窗。
            -->
            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/session_remote_video"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/an_space_s"
                android:background="@color/an_ink"
                android:contentDescription="@string/session_call_video_desc"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/session_call_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:textAppearance="@style/TextAppearance.Sullivan.Body"
                android:visibility="gone"
                tools:text="正在呼叫…"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/session_chat_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_xs"
                android:text="@string/session_chat_hint"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption" />

            <ScrollView
                android:id="@+id/session_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/an_space_m"
                android:background="@drawable/an_log_panel"
                android:padding="@dimen/an_space_m">

                <TextView
                    android:id="@+id/session_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/an_log_text"
                    android:textSize="14sp"
                    tools:text="[连接] 已建立\n[对方] 到家了吗" />
            </ScrollView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Sullivan.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:hint="@string/session_message_field">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/session_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="3"
                    android:textColor="@color/an_ink"
                    android:textSize="@dimen/an_text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/session_send"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/session_action_send" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/session_ping"
                    style="@style/Widget.Sullivan.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/an_touch_min"
                    android:layout_marginEnd="@dimen/an_space_s"
                    android:layout_weight="1"
                    android:text="@string/session_action_ping"
                    android:textSize="15sp" />

                <!-- 「挂断」而不是「断开」：这一页现在承载的是通话，用户心里的动作就是挂断 -->
                <Button
                    android:id="@+id/session_disconnect"
                    style="@style/Widget.Sullivan.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/an_touch_min"
                    android:layout_weight="1"
                    android:text="@string/session_action_hangup"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
