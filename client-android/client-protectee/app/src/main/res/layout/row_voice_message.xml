<?xml version="1.0" encoding="utf-8"?>
<!--
    一条语音留言。

    三个动作（播放 / 标记已听 / 删除）都在布局里声明，由代码按状态显隐：
    - 「已听」只有接收方、且还没标记过时才出现；
    - 删除双方都能点。

    理由与 row_binding 一致：代码 new 出来的 Button 拿不到 MaterialButton 的样式。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/an_space_m"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/voice_row_status"
            style="@style/Widget.Sullivan.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/an_chip_neutral"
            android:textAppearance="@style/TextAppearance.Sullivan.Caption"
            tools:text="未听" />

        <TextView
            android:id="@+id/voice_row_side"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/an_space_s"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Sullivan.Caption"
            tools:text="收到的" />
    </LinearLayout>

    <TextView
        android:id="@+id/voice_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:textAppearance="@style/TextAppearance.Sullivan.Title"
        tools:text="来自张三的留言" />

    <TextView
        android:id="@+id/voice_row_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_xs"
        android:textAppearance="@style/TextAppearance.Sullivan.Caption"
        tools:text="32 秒 · 2026-10-26 17:30" />

    <TextView
        android:id="@+id/voice_row_playback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:textAppearance="@style/TextAppearance.Sullivan.Body"
        android:visibility="gone"
        tools:text="正在播放…"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:orientation="horizontal">

        <Button
            android:id="@+id/voice_row_play"
            style="@style/Widget.Sullivan.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginEnd="@dimen/an_space_s"
            android:layout_weight="1"
            android:text="@string/voice_action_play"
            android:textSize="15sp" />

        <Button
            android:id="@+id/voice_row_listened"
            style="@style/Widget.Sullivan.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginEnd="@dimen/an_space_s"
            android:layout_weight="1"
            android:text="@string/voice_action_mark_listened"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/voice_row_delete"
            style="@style/Widget.Sullivan.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_weight="1"
            android:text="@string/voice_action_delete"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
