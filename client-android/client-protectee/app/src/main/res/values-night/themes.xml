<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        深色模式：只翻「系统栏图标的明暗」，配色本身全部由 values-night/colors.xml 接管 ——
        Base.Theme.Sullivan 引用的都是 an_* 令牌，令牌一换，主题不用重写一遍。

        必须重申 parent：style 是按配置整包替换的，这个包不含颜色属性，
        全靠 Base.Theme.Sullivan 继承过来。反过来，也正因为是整包替换，
        不能在这里省掉 parent 去「只覆盖两条」。
    -->
    <style name="Theme.Sullivan" parent="Base.Theme.Sullivan">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
