<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        权限只列本应用真正用到的项。

        与 client-guardian 的差别（不是漏抄）：RECORD_AUDIO 曾经也是这里刻意
        不声明的一项 —— 那时代码里确实没有任何录音调用；现在「语音留言」
        （VoiceMessageActivity + VoiceRecorder）用 MediaRecorder 录音，
        它成了实体功能，必须声明并在运行时向用户申请。

        定位权限是例外：报警要把受护人的位置发给监护人，这是 FR-06 的实体功能，
        由 LocationReporter 真正调用（getLastKnownLocation / requestLocationUpdates）。
        声明 ACCESS_COARSE_LOCATION 是必要的：只有精确权限时，Android 12+ 仍然要求
        两者同时声明才能让用户选择「大概位置」。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        WebRTC 建第一条 PeerConnection 时会启动 NetworkMonitor，它要读网络状态；
        没有这一项，实时通话一发起就触发
        java.lang.SecurityException → libjingle network_thread 直接 abort，
        表现是「一点连接就闪回首页、会话永远停在正在接通」。
        INTERNET 不覆盖它 —— 这是两个独立的权限。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 剧烈晃动报警的振动提示（PromptAnnouncer） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 语音留言的录音（VoiceRecorder / MediaRecorder），运行时向用户申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        来电监听前台服务。对方发起实时会话时，受护人多半没打开应用 ——
        没有这两项「服务器建了会话、受护人收不到通知」。
        与监护人端 IncomingCallService 的选型一致：specialUse 而不是 dataSync，
        后者 Android 14+ 限制每天 6 小时，对"全天候守着"等于不可用。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知要用户授权，没有它前台服务的通知根本不显示。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 本应用的全部价值都在后置摄像头上，没有相机就不该装 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <!-- 陀螺仪**不是**必需：缺失时报警功能关闭并提示一次，其余功能照常 -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <application
        android:name=".SullivanApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sullivan"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic：后端是 http://<局域网IP>:8642，没有 TLS。
            不开这一项，Android 9+ 会直接掐掉所有明文请求。
            这是**已知风险**而非疏漏：明文下二维码票据与最终令牌
            对同网段任何人都可见。详见 docs/final/17-开发日记-2026-10-16.md
            与 19-待办-安全与性能加固.md。
        -->

        <!--
            启动页：受护人主页。
            **本工程没有角色入口页** —— 这个应用里没有第二个角色可切，
            多摆一页只会让低视力用户每次启动都多点一次。
            主页上「开始障碍检测」那张卡永远可点，登录态、令牌过期、断网都不影响它。
            锁竖屏：这一页是给用户拿在手上的，横竖切换会重建 Activity 并打断朗读。
        -->
        <activity
            android:name=".ui.protectee.home.ProtecteeHomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            受护人障碍检测页：端侧障碍检测本体。
            必须锁竖屏且声明 configChanges —— 旋转会重建 Activity 从而拆掉 CameraX 绑定，
            而预览画面与叠加层的坐标换算都假设画面几何在 Activity 生命周期内不变。
        -->
        <activity
            android:name=".ui.protectee.home.ProtecteeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sullivan.Camera" />

        <!-- 受护人「我的绑定码」：登录后才可以进，展示绑定二维码 + 可朗读的短码。 -->
        <activity
            android:name=".ui.protectee.binding.BindCodeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 受护人扫码登录：出示登录二维码并轮询，换到令牌即回到主页。 -->
        <activity
            android:name=".ui.protectee.login.QrLoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait" />

        <!--
            绑定管理：三个页签（我的绑定 / 发起绑定 / 查找账号），锁竖屏。
            横竖切换会重建 Activity，而刷新后的列表与页签位置对应不上，
            用户会以为「刚刚确认的那条不见了」。
        -->
        <activity
            android:name=".ui.common.binding.BindingListActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />


        <!--
            实时会话：列表 + 长连接收发。锁竖屏，因为横竖切换会重建 Activity，
            而长连接是建在 Activity 生命周期上的 —— 重建会把它断掉，
            用户正在等的消息就永远等不到了。
        -->
        <activity
            android:name=".ui.common.realtime.RealtimeActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!--
            语音留言：录音、发送、收听已绑定对方留下的音频。
            **不在这里写会直接导致点击「语音留言」卡就闪退**：
            startActivity 指向未注册的 Activity 会抛 ActivityNotFoundException。
            录音权限在页内第一次点「开始录音」时申请（见 VoiceMessageActivity）。
        -->
        <activity
            android:name=".ui.common.voice.VoiceMessageActivity"
            android:screenOrientation="portrait" />

        <!--
            来电监听：常驻前台服务，5 秒查一次有没有人在呼叫我。
            exported=false：只由本应用启动。登录后由受护人主页启动，退出即停。
        -->
        <service
            android:name=".service.call.IncomingCallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alert_incoming_call_monitoring" />
        </service>
    </application>
</manifest>
