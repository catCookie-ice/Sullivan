<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 剧烈晃动报警的振动提示（PromptAnnouncer） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        来电监听前台服务。受护人的求助最可能发生在监护人没打开应用的时候，
        没有这两项时「服务器建了会话、监护人收不到通知」——
        这正是用户实测反馈的故障。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知要用户授权，没有它前台服务的通知根本不显示。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 受护人端侧检测依赖后置摄像头 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <!-- 陀螺仪**不是**必需：缺失时报警功能关闭并提示一次，其余功能照常 -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <application
        android:name=".SullivanApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sullivan"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic：后端是 http://<局域网IP>:8642，没有 TLS。
            不开这一项，Android 9+ 会直接掐掉所有明文请求。
            这是**已知风险**而非疏漏：明文下登录密码、二维码票据与最终令牌
            对同网段任何人都可见。详见 docs/final/17-开发日记-2026-10-16.md。
        -->

        <!-- 三角色入口：受护人 / 监护人 / 志愿者 -->
        <activity
            android:name=".ui.roleentry.RoleEntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 监护人账密登录。扫码授权要求监护人已登录，所以这一步不能也用扫码。 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!--
            注册：只有监护人/志愿者能自助注册，受护人账号由监护人代建。
            锁竖屏：这是一整页表单，横竖切换会重建 Activity 并清掉已输入的内容，
            而用户此时多半正在对着屏幕外的纸抄一个手机号。
        -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 找回密码：三步向导，每一步的选项都依赖上一步的响应，同样不能横竖重建。 -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!--
            受护人端（扫码登录 / 障碍检测页 / 我的绑定码 / 受护人主页）已拆成
            独立工程 client-android/client-protectee（应用名「Sullivan 守护」）。
            那 4 个 Activity 与它们的布局、vision/ 包一并迁出本工程；
            在这里声明一个指向不存在类的 Activity 会留下点了就崩的入口，所以删干净。
            监护人侧「扫受护人登录码」仍在，见 ui.common.scan.QrScanActivity。
        -->

        <!-- 监护人主页：扫码绑定 / 扫受护人登录码 / 绑定与账号管理入口。 -->
        <activity android:name=".ui.guardian.home.GuardianActivity" />

        <!-- 绑定管理：三个页签（我的绑定 / 发起绑定 / 查找账号），锁竖屏。
             横竖切换会重建 Activity，而刷新后的列表与页签位置对应不上，
             用户会以为「刚刚确认的那条不见了」。 -->
        <activity
            android:name=".ui.guardian.binding.BindingListActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 创建受护人：一整页表单，同样锁竖屏（旋转会清掉已输入的登录名与密码）。 -->
        <activity
            android:name=".ui.guardian.binding.CreateProtecteeActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 志愿者兼任申请：提交 + 申请记录 + 撤销。 -->
        <activity
            android:name=".ui.guardian.volunteer.VolunteerApplyActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 公益活动列表（只读）：监护人与志愿者共用，需要登录。 -->
        <activity
            android:name=".ui.common.activity.ActivityListActivity"
            android:screenOrientation="portrait" />

        <!--
            实时会话：列表 + 长连接收发。锁竖屏，因为横竖切换会重建 Activity，
            而长连接是建在 Activity 生命周期上的 —— 重建会把它断掉，
            用户正在等的消息就永远等不到了。
        -->
        <activity
            android:name=".ui.common.realtime.RealtimeActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 通用扫码页：不透明全屏主题；自己申请 CAMERA 权限（监护人可能是全新安装）。 -->
        <activity
            android:name=".ui.common.scan.QrScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sullivan.Camera" />

        <!-- 志愿者主页：只有「是志愿者且不是监护人」的账号落到这里，见 LoginActivity.homeIntentFor。 -->
        <activity
            android:name=".ui.volunteer.home.VolunteerHomeActivity"
            android:screenOrientation="portrait" />

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />

        <!--
            来电监听：常驻前台服务，5 秒查一次有没有人在呼叫我。
            exported=false：只由本应用启动。

            foregroundServiceType 用 specialUse 而不是 dataSync：Android 14+
            对 dataSync 类型限制每天 6 小时，超时会被系统直接杀掉 —— 对一个
            "全天候守着"的功能来说等于不可用。specialUse 没有这个时限，
            代价是上架 Google Play 需要单独申报用途（本项目为课程/毕业设计，
            不上架，故不受此限）。
        -->
        <service
            android:name=".service.call.IncomingCallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alert_incoming_call_monitoring" />
        </service>
    </application>
</manifest>
