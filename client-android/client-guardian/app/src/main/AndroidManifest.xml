<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 剧烈晃动报警的振动提示（PromptAnnouncer） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 受护人端侧检测依赖后置摄像头 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <!-- 陀螺仪**不是**必需：缺失时报警功能关闭并提示一次，其余功能照常 -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <application
        android:name=".SullivanApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Sullivan"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sullivan"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic：后端是 http://<局域网IP>:8642，没有 TLS。
            不开这一项，Android 9+ 会直接掐掉所有明文请求。
            这是**已知风险**而非疏漏：明文下登录密码、二维码票据与最终令牌
            对同网段任何人都可见。详见 docs/final/17-开发日记-2026-10-16.md。
        -->

        <!-- 三角色入口：受护人 / 监护人 / 志愿者 -->
        <activity
            android:name=".ui.roleentry.RoleEntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 监护人账密登录。扫码授权要求监护人已登录，所以这一步不能也用扫码。 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!--
            注册：只有监护人/志愿者能自助注册，受护人账号由监护人代建。
            锁竖屏：这是一整页表单，横竖切换会重建 Activity 并清掉已输入的内容，
            而用户此时多半正在对着屏幕外的纸抄一个手机号。
        -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 找回密码：三步向导，每一步的选项都依赖上一步的响应，同样不能横竖重建。 -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 受护人扫码登录：出示登录二维码并轮询，换到令牌即进入受护人主页。 -->
        <activity
            android:name=".ui.login.QrLoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait" />

        <!--
            受护人障碍检测页：端侧障碍检测本体。
            必须锁竖屏且声明 configChanges —— 旋转会重建 Activity 从而拆掉 CameraX 绑定，
            而预览画面与叠加层的坐标换算都假设画面几何在 Activity 生命周期内不变。
        -->
        <activity
            android:name=".ui.protectee.home.ProtecteeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sullivan.Camera" />

        <!-- 受护人「我的绑定码」：登录后才可以进，展示绑定二维码 + 可朗读的短码。 -->
        <activity
            android:name=".ui.protectee.binding.BindCodeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 监护人主页：扫码绑定 / 扫受护人登录码 / 绑定与账号管理入口。 -->
        <activity android:name=".ui.guardian.home.GuardianActivity" />

        <!-- 绑定管理：三个页签（我的绑定 / 发起绑定 / 查找账号），锁竖屏。
             横竖切换会重建 Activity，而刷新后的列表与页签位置对应不上，
             用户会以为「刚刚确认的那条不见了」。 -->
        <activity
            android:name=".ui.guardian.binding.BindingListActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 创建受护人：一整页表单，同样锁竖屏（旋转会清掉已输入的登录名与密码）。 -->
        <activity
            android:name=".ui.guardian.binding.CreateProtecteeActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 志愿者兼任申请：提交 + 申请记录 + 撤销。 -->
        <activity
            android:name=".ui.guardian.volunteer.VolunteerApplyActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 公益活动列表（只读）：监护人与志愿者共用，需要登录。 -->
        <activity
            android:name=".ui.common.activity.ActivityListActivity"
            android:screenOrientation="portrait" />

        <!--
            实时会话：列表 + 长连接收发。锁竖屏，因为横竖切换会重建 Activity，
            而长连接是建在 Activity 生命周期上的 —— 重建会把它断掉，
            用户正在等的消息就永远等不到了。
        -->
        <activity
            android:name=".ui.common.realtime.RealtimeActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 通用扫码页：不透明全屏主题；自己申请 CAMERA 权限（监护人可能是全新安装）。 -->
        <activity
            android:name=".ui.common.scan.QrScanActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Sullivan.Camera" />

        <!--
            受护人主页（登录后）：障碍检测 + 账号相关入口。
            **不锁竖屏之外的特殊主题**：这一页是普通界面，不碰相机。
            但它必须在角色入口的第一屏可达 —— 受护人不会再去找别的入口。
        -->
        <activity
            android:name=".ui.protectee.home.ProtecteeHomeActivity"
            android:screenOrientation="portrait" />

        <!-- 志愿者主页：只有「是志愿者且不是监护人」的账号落到这里，见 LoginActivity.homeIntentFor。 -->
        <activity
            android:name=".ui.volunteer.home.VolunteerHomeActivity"
            android:screenOrientation="portrait" />

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />
    </application>
</manifest>
