<?xml version="1.0" encoding="utf-8"?>
<!--
    监护人登录（账号 + 密码）。

    为什么监护人必须用账密登录、不能也用扫码：扫码授权这条路的前提是
    「扫码的这个人已经被认证过了」。受护人的登录码要靠监护人确认才生效，
    若监护人也靠别人扫他来登录，这套信任链就没有起点。

    表单装在一张 an_card 里而不是拱券卡：拱券的上方两角半径 96dp，
    表单第一行控件会落在切角里；拱券留给「一整块、内容居中」的卡片用。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.login.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/an_flourish_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sullivan.Label" />

                <TextView
                    android:id="@+id/login_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/login_title"
                    android:textAppearance="@style/TextAppearance.Sullivan.Display" />

                <TextView
                    android:id="@+id/login_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/login_subtitle"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/an_space_m"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_divider_vine" />

        <LinearLayout
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Sullivan.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_field_account">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/an_ink"
                    android:textSize="@dimen/an_text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Sullivan.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:hint="@string/login_field_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/an_ink"
                    android:textSize="@dimen/an_text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/login_submit"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_l"
                android:text="@string/login_action_submit" />

            <TextView
                android:id="@+id/login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:textColor="@color/an_gold_deep"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="正在登录…"
                tools:visibility="visible" />
        </LinearLayout>

        <!--
            注册与找回放在扫码登录下面一行：它们都是「账号出问题时」的旁路，
            不该和主表单抢同一块视觉重量。两个都是 Ghost（纯文字）样式，
            但高度仍是 an_button_height，触控目标一点没缩。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="horizontal">

            <Button
                android:id="@+id/login_register"
                style="@style/Widget.Sullivan.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="@dimen/an_button_height"
                android:layout_weight="1"
                android:text="@string/login_action_register" />

            <Button
                android:id="@+id/login_forgot"
                style="@style/Widget.Sullivan.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="@dimen/an_button_height"
                android:layout_weight="1"
                android:text="@string/login_action_forgot" />
        </LinearLayout>

        <Button
            android:id="@+id/login_protectee_qr"
            style="@style/Widget.Sullivan.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/an_button_height"
            android:layout_marginTop="@dimen/an_space_m"
            android:text="@string/login_action_scan_login" />
    </LinearLayout>
</ScrollView>
