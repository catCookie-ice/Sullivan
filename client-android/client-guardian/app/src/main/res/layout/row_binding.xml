<?xml version="1.0" encoding="utf-8"?>
<!--
    绑定关系的一行。

    「对方」显示的是账号 ID 而不是显示名：绑定接口只返回双方的 ID，
    没有名字。要显示名字得为每条关系再调一次 GET users/{id}，
    列表十条就是十个请求，而其中绝大多数是用户扫一眼就划过去的。
    所以 id 原样显示，并在页面上说明「账号 ID」是这里的通用标识。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/an_space_m"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/binding_row_status"
            style="@style/Widget.Sullivan.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/an_chip_neutral"
            android:textAppearance="@style/TextAppearance.Sullivan.Caption"
            tools:text="已生效" />

        <TextView
            android:id="@+id/binding_row_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/an_space_s"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Sullivan.Caption"
            android:textColor="@color/an_gold_deep"
            tools:text="等你确认" />
    </LinearLayout>

    <TextView
        android:id="@+id/binding_row_counterpart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:textAppearance="@style/TextAppearance.Sullivan.Title"
        tools:text="对方：u_9876543210" />

    <TextView
        android:id="@+id/binding_row_side"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_xs"
        android:textAppearance="@style/TextAppearance.Sullivan.Caption"
        tools:text="我在这条关系里是监护人" />

    <TextView
        android:id="@+id/binding_row_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_xs"
        android:textAppearance="@style/TextAppearance.Sullivan.Caption"
        tools:text="发起方：我 · 永久绑定" />

    <!--
        动作区：四个按钮都在布局里，按 BindingActionPolicy 的结果显隐。

        不做成运行时 new Button()：MaterialComponents 主题下按钮的样式来自
        style 属性，而代码里 new 出来的 AppCompatButton 拿不到那套 backgroundTint /
        strokeColor，画出来会是系统默认的灰块 —— 与页面其余按钮明显不是一套。
    -->
    <LinearLayout
        android:id="@+id/binding_row_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_s"
        android:orientation="horizontal">

        <Button
            android:id="@+id/binding_row_accept"
            style="@style/Widget.Sullivan.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginEnd="@dimen/an_space_s"
            android:layout_weight="1"
            android:text="@string/binding_action_accept"
            android:textSize="15sp" />

        <Button
            android:id="@+id/binding_row_reject"
            style="@style/Widget.Sullivan.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginEnd="@dimen/an_space_s"
            android:layout_weight="1"
            android:text="@string/binding_action_reject"
            android:textSize="15sp" />

        <Button
            android:id="@+id/binding_row_cancel"
            style="@style/Widget.Sullivan.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_weight="1"
            android:text="@string/binding_action_cancel"
            android:textSize="15sp" />

        <Button
            android:id="@+id/binding_row_terminate"
            style="@style/Widget.Sullivan.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="@dimen/an_touch_min"
            android:layout_weight="1"
            android:text="@string/binding_action_terminate"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
