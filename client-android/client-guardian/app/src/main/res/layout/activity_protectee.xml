<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.protectee.home.ProtecteeActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.sullivan.android.vision.view.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部状态栏：模型状态、推理性能、更换模型入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/panel_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/model_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:text="模型就绪：yolov8n.onnx · 640" />

        <TextView
            android:id="@+id/perf_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:text="8.4 FPS · 96 ms" />

        <!--
            我的绑定码：登录后才能展示绑定码（未登录时进去会先走扫码登录）。
            放在模型状态这一行上，与「更换模型」并列 —— 两者都是低频入口，
            不该占用障碍检测的主画面。
        -->
        <Button
            android:id="@+id/my_bind_code_button"
            style="@style/Widget.Sullivan.Button.CameraGhost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_my_bind_code"
            android:textSize="12sp" />

        <Button
            android:id="@+id/pick_model_button"
            style="@style/Widget.Sullivan.Button.CameraGhost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_pick_model"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 底部提示区：主提示文字 + 播报开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/panel_scrim"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/prompt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/prompt_idle"
            android:textColor="@color/level_clear"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/speech_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/switch_speech"
                android:textColor="@color/white"
                app:thumbTint="@color/an_camera_switch_thumb"
                app:trackTint="@color/an_camera_switch_track" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/haptics_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/switch_haptics"
                android:textColor="@color/white"
                app:thumbTint="@color/an_camera_switch_thumb"
                app:trackTint="@color/an_camera_switch_track" />
        </LinearLayout>

        <!--
            频率档位单独占一整行。三个控件平分宽度的话「播报频率：标准」会被挤成两行，
            而这三种控件都需要足够大的点击目标。
        -->
        <Button
            android:id="@+id/rate_button"
            style="@style/Widget.Sullivan.Button.CameraOutline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginTop="4dp"
            android:text="@string/rate_standard" />
    </LinearLayout>

    <!--
        剧烈晃动报警面板：画在底部提示区**之上**（FrameLayout 里后声明的盖住先声明的）。
        不透明背景是有意的——报警期间场景文字还在后面刷新，但此刻用户需要的是这一句。
        只有按钮可点：整块面板都能点掉的话，摔倒时手撑地压到屏幕就会把报警关掉。
    -->
    <LinearLayout
        android:id="@+id/alarm_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/level_danger"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/alarm_shake"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/alarm_dismiss_button"
            style="@style/Widget.Sullivan.Button.Alarm"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/action_im_fine" />
    </LinearLayout>

    <!-- 权限提示，仅在未授权时显示 -->
    <LinearLayout
        android:id="@+id/permission_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/panel_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/prompt_no_permission"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/grant_permission_button"
            style="@style/Widget.Sullivan.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/an_button_height"
            android:layout_marginTop="12dp"
            android:paddingStart="@dimen/an_space_l"
            android:paddingEnd="@dimen/an_space_l"
            android:text="@string/prompt_grant" />
    </LinearLayout>

</FrameLayout>
