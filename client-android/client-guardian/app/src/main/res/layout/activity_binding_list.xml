<?xml version="1.0" encoding="utf-8"?>
<!--
    绑定管理：三个页签（我的绑定 / 发起绑定 / 查找账号）。

    <b>页签用 Material TabLayout，不做指示条自绘</b>：TabLayout 在这一页的价值是
    「告诉你有三块内容、你现在在哪一块」，而这正好是它的默认行为。
    新艺术运动的那套装饰放在卡面与页头上，不必把一个系统控件也掰弯 ——
    它的默认指示条已经是细线，换成古金色即可（见 app:tabIndicatorColor）。

    <b>三个页签的布局是并排的三块，靠 visibility 切换</b>，不用 ViewPager2：
    三个页签之间没有滑动切换的语义（它们是三种不同的任务），
    而 ViewPager2 会让人本能地左右滑，滑到一半才发现在填表。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/an_bg_page"
    android:orientation="vertical"
    tools:context=".ui.guardian.binding.BindingListActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/an_space_l"
        android:paddingTop="@dimen/an_space_xl"
        android:paddingEnd="@dimen/an_space_l">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/an_flourish_corner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Sullivan.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_xs"
                android:text="@string/binding_title"
                android:textAppearance="@style/TextAppearance.Sullivan.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/binding_subtitle"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/binding_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/an_space_m"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/an_gold"
        app:tabSelectedTextColor="@color/an_ink"
        app:tabTextColor="@color/an_ink_3" />

    <!-- ===== 页签一：我的绑定 ===== -->
    <FrameLayout
        android:id="@+id/binding_panel_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/binding_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/an_space_l"
            android:paddingEnd="@dimen/an_space_l"
            android:paddingBottom="@dimen/an_space_xl"
            tools:listitem="@layout/row_binding" />

        <com.sullivan.android.ui.common.components.StateView
            android:id="@+id/binding_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/binding_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/an_space_l"
            android:backgroundTint="@color/an_button_tint"
            android:contentDescription="@string/binding_action_refresh"
            android:text="@string/binding_action_refresh"
            android:textColor="@color/an_ink"
            app:icon="@drawable/an_refresh_icon"
            app:iconTint="@color/an_ink" />
    </FrameLayout>

    <!-- ===== 页签二：发起绑定 ===== -->
    <ScrollView
        android:id="@+id/binding_panel_request"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/an_space_l"
            android:paddingTop="@dimen/an_space_m"
            android:paddingEnd="@dimen/an_space_l"
            android:paddingBottom="@dimen/an_space_xl">

            <LinearLayout
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/binding_request_as_guardian"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/binding_request_as_guardian_hint"
                    android:textAppearance="@style/TextAppearance.Sullivan.Caption" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Sullivan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_m"
                    android:hint="@string/binding_lookup_field">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/binding_request_protectee_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/an_ink"
                        android:textSize="@dimen/an_text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/binding_request_as_guardian"
                    style="@style/Widget.Sullivan.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/an_button_height"
                    android:layout_marginTop="@dimen/an_space_m"
                    android:text="@string/binding_request_as_guardian_action" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:text="@string/binding_request_owner_hint"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption" />

            <TextView
                android:id="@+id/binding_request_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="绑定请求已发起，等对方确认"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== 页签三：查找账号 ===== -->
    <ScrollView
        android:id="@+id/binding_panel_lookup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/an_space_l"
            android:paddingTop="@dimen/an_space_m"
            android:paddingEnd="@dimen/an_space_l"
            android:paddingBottom="@dimen/an_space_xl">

            <LinearLayout
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/binding_lookup_title"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Sullivan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_m"
                    android:hint="@string/binding_lookup_field">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/binding_lookup_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/an_ink"
                        android:textSize="@dimen/an_text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/binding_lookup_action"
                    style="@style/Widget.Sullivan.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/an_button_height"
                    android:layout_marginTop="@dimen/an_space_m"
                    android:text="@string/binding_lookup_action" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/binding_lookup_result"
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/binding_lookup_result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title"
                    tools:text="账号 u_123" />

                <TextView
                    android:id="@+id/binding_lookup_result_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body"
                    tools:text="显示名：张三\n主角色：监护人\n状态：正常" />
            </LinearLayout>

            <TextView
                android:id="@+id/binding_lookup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="查找失败：请求的内容不存在或已失效"
                tools:textColor="@color/an_terracotta"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
