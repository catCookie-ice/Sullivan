<?xml version="1.0" encoding="utf-8"?>
<!--
    受护人主页（登录后）。

    这一屏的读者是低视力用户，所以两条规则压过一切装饰：
      1. 「开始障碍检测」永远是第一张、永远可见、永远可点 —— 它不需要登录，
         任何情况下都不能被登录状态挡住；
      2. 其余卡片的点击目标一律 ≥ 96dp，正文不缩小。

    「我的账号」分两块（protectee_account_guest / protectee_account_member），
    由代码按登录态切换。未登录时**不隐藏**绑定码、活动、实时会话这几张卡 ——
    受护人看不到「登录之后有什么」，就没有理由去登录；点它们会先去扫码登录，
    登完直接进目标页。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.protectee.home.ProtecteeHomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/an_flourish_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sullivan.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/role_protectee"
                    android:textAppearance="@style/TextAppearance.Sullivan.Display" />

                <TextView
                    android:id="@+id/protectee_home_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body"
                    tools:text="当前账号：王小明" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/an_space_m"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_divider_vine" />

        <!-- ===== 障碍检测：无论登录与否都在这里，且排在最前 ===== -->
        <LinearLayout
            android:id="@+id/protectee_card_detect"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:clickable="true"
            android:contentDescription="@string/protectee_home_detect_desc"
            android:focusable="true"
            android:minHeight="140dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protectee_home_action_detect"
                android:textAppearance="@style/TextAppearance.Sullivan.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/protectee_home_detect_desc"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_xl"
            android:text="@string/protectee_home_section_account"
            android:textAppearance="@style/TextAppearance.Sullivan.Section" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/an_space_s"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_section_rule" />

        <!-- ===== 未登录 ===== -->
        <LinearLayout
            android:id="@+id/protectee_account_guest"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_m"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protectee_home_login_hint"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />

            <Button
                android:id="@+id/protectee_home_login"
                style="@style/Widget.Sullivan.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_m"
                android:text="@string/protectee_home_action_login" />
        </LinearLayout>

        <!-- ===== 已登录 ===== -->
        <LinearLayout
            android:id="@+id/protectee_account_member"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/protectee_card_bind_code"
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:clickable="true"
                android:contentDescription="@string/protectee_home_bind_code_desc"
                android:focusable="true"
                android:minHeight="96dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protectee_home_action_bind_code"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/protectee_home_bind_code_desc"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/protectee_card_bindings"
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:clickable="true"
                android:contentDescription="@string/protectee_home_bindings_desc"
                android:focusable="true"
                android:minHeight="96dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardian_action_bindings"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/protectee_home_bindings_desc"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/protectee_card_activities"
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:clickable="true"
                android:contentDescription="@string/guardian_action_activities_desc"
                android:focusable="true"
                android:minHeight="96dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardian_action_activities"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/guardian_action_activities_desc"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/protectee_card_realtime"
                style="@style/Widget.Sullivan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:clickable="true"
                android:contentDescription="@string/guardian_action_realtime_desc"
                android:focusable="true"
                android:minHeight="96dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardian_action_realtime"
                    android:textAppearance="@style/TextAppearance.Sullivan.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/guardian_action_realtime_desc"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>

            <Button
                android:id="@+id/protectee_home_logout"
                style="@style/Widget.Sullivan.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_button_height"
                android:layout_marginTop="@dimen/an_space_l"
                android:text="@string/protectee_home_action_logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
