<?xml version="1.0" encoding="utf-8"?>
<!--
    语音留言：录一段、发给已绑定的对方，或者听对方留下的。

    和实时会话的区别是「不需要对方在场」：打电话要两个人同时有空，
    留言不用。所以这一页的最上面是录制，下面是收到与发出的两份列表。

    <b>音频不走 <audio src> 之类的裸链</b>：服务端的音频端点每次都重新校验
    「双方仍有生效绑定」，所以必须带令牌取回（见 VoiceMessageActivity）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.common.voice.VoiceMessageActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/an_flourish_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sullivan.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/voice_title"
                    android:textAppearance="@style/TextAppearance.Sullivan.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/voice_subtitle"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/an_space_m"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_divider_vine" />

        <!-- ===== 录一条 ===== -->
        <LinearLayout
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voice_record_title"
                android:textAppearance="@style/TextAppearance.Sullivan.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_xs"
                android:text="@string/voice_record_to_label"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption" />

            <Spinner
                android:id="@+id/voice_target"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_touch_min"
                android:layout_marginTop="@dimen/an_space_s"
                android:contentDescription="@string/voice_record_to_label"
                android:spinnerMode="dialog" />

            <TextView
                android:id="@+id/voice_target_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/voice_no_contact"
                android:textAppearance="@style/TextAppearance.Sullivan.Caption"
                android:visibility="gone"
                tools:text="@string/voice_no_contact"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/voice_record_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:textAppearance="@style/TextAppearance.Sullivan.Body"
                android:visibility="gone"
                tools:text="录音中 12 秒 / 最多 60 秒"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/voice_record_toggle"
                    style="@style/Widget.Sullivan.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/an_button_height"
                    android:layout_marginEnd="@dimen/an_space_s"
                    android:layout_weight="1"
                    android:text="@string/voice_action_start" />

                <Button
                    android:id="@+id/voice_record_send"
                    style="@style/Widget.Sullivan.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/an_button_height"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/voice_action_send" />
            </LinearLayout>

            <Button
                android:id="@+id/voice_record_discard"
                style="@style/Widget.Sullivan.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/an_touch_min"
                android:layout_marginTop="@dimen/an_space_xs"
                android:text="@string/voice_action_discard"
                android:visibility="gone" />

            <TextView
                android:id="@+id/voice_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_m"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="已发送，对方下次打开就能听到"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- ===== 收到的 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_xl"
            android:text="@string/voice_inbox_title"
            android:textAppearance="@style/TextAppearance.Sullivan.Section" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/an_space_s"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_section_rule" />

        <Button
            android:id="@+id/voice_refresh"
            style="@style/Widget.Sullivan.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/an_touch_min"
            android:layout_marginTop="@dimen/an_space_xs"
            android:text="@string/voice_action_refresh" />

        <com.sullivan.android.ui.common.components.StateView
            android:id="@+id/voice_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/voice_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
