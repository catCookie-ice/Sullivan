<?xml version="1.0" encoding="utf-8"?>
<!--
    角色选择入口（docs/final/00 §4.2）。
    每个角色是一整块可点区域：靠 TalkBack 逐个聚焦，点击目标做得足够大，
    且每块都带 contentDescription，读出来就能听懂这个角色是干什么的。

    受护人不在这一页：受护人端已拆成独立应用 Sullivan 守护（client-protectee）。

    视觉上是新艺术运动风格的第一屏：羊皮纸底、左上角花蔓、衬线标题、
    错位双框卡片。装饰元素（花蔓、藤蔓线）一律 importantForAccessibility="no" ——
    它们没有语义，出现在朗读序列里只会让 TalkBack 用户多按几次。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sullivan.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.roleentry.RoleEntryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 页头。花蔓贴右上角并旋转 90°，让卷须朝标题这边甩过来。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/an_flourish_corner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Sullivan.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_xs"
                    android:text="@string/role_entry_title"
                    android:textAppearance="@style/TextAppearance.Sullivan.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/an_space_s"
                    android:text="@string/role_entry_subtitle"
                    android:textAppearance="@style/TextAppearance.Sullivan.Body" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/an_space_m"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/an_divider_vine" />

        <!--
            ===== 监护人 =====
            受护人卡片已移至独立工程 client-protectee（见 RoleEntryActivity 的类注释）。
            本页仍是第一屏，所以监护人卡片改成 an_space_l 上边距，接着页头那道藤蔓分隔线。
        -->
        <LinearLayout
            android:id="@+id/card_guardian"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_l"
            android:clickable="true"
            android:contentDescription="@string/role_guardian_desc"
            android:focusable="true"
            android:minHeight="96dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/role_guardian"
                android:textAppearance="@style/TextAppearance.Sullivan.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/role_guardian_desc"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />
        </LinearLayout>

        <!-- ===== 志愿者 ===== -->
        <LinearLayout
            android:id="@+id/card_volunteer"
            style="@style/Widget.Sullivan.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/an_space_m"
            android:clickable="true"
            android:contentDescription="@string/role_volunteer_desc"
            android:focusable="true"
            android:minHeight="96dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/role_volunteer"
                android:textAppearance="@style/TextAppearance.Sullivan.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/an_space_s"
                android:text="@string/role_volunteer_desc"
                android:textAppearance="@style/TextAppearance.Sullivan.Body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
