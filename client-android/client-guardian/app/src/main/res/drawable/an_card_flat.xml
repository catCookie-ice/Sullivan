<?xml version="1.0" encoding="utf-8"?>
<!--
    简版卡片：没有错位双框，只有一层浅底 + 极淡的描边。

    列表行用它。一屏十条错位双框会非常吵，而且错位线在紧凑行里会跟文字抢注意力。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/an_paper_card" />
    <stroke
        android:width="@dimen/an_stroke_hair"
        android:color="@color/an_line_soft" />
    <corners
        android:bottomLeftRadius="@dimen/an_radius_xs"
        android:bottomRightRadius="@dimen/an_radius_s"
        android:topLeftRadius="@dimen/an_radius_m"
        android:topRightRadius="@dimen/an_radius_xs" />
</shape>
