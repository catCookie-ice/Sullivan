<?xml version="1.0" encoding="utf-8"?>
<!--
    藤蔓分隔线（whiplash）：一条不对称的 S 形主茎 + 三片叶芽。

    新艺术运动的标志性线条是「鞭线」（whiplash）—— 一条起笔沉、收笔甩出去的连续曲线。
    <shape> 画不出来，只能用 vector path。
    用作 ImageView 的 src，宽度 match_parent 时会被拉伸，所以 viewport 取 240 是为了
    在常见手机宽度下横向拉伸比接近 1，叶芽不会被拉成椭圆。

    颜色写死成 an_gold_pale 而不套 android:tint：tint 要在每个使用处重复写一遍，
    这条件本身就是装饰性的，只有一个合理的颜色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="20dp"
    android:viewportWidth="240"
    android:viewportHeight="20">

    <path
        android:pathData="M2,10 C40,10 44,-2 74,4 C104,10 96,18 132,14 C168,10 176,2 206,6 C222,8 230,10 238,10"
        android:strokeColor="@color/an_gold_pale"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

    <path
        android:fillColor="@color/an_gold_pale"
        android:pathData="M58,4 c5,-4 11,-2 12,3 c-5,4 -11,3 -12,-3 z" />
    <path
        android:fillColor="@color/an_gold_pale"
        android:pathData="M150,15 c-5,4 -11,2 -12,-3 c5,-4 11,-3 12,3 z" />
    <path
        android:fillColor="@color/an_gold_pale"
        android:pathData="M210,5 c4,-5 10,-4 12,1 c-5,4 -11,4 -12,-1 z" />
</vector>
