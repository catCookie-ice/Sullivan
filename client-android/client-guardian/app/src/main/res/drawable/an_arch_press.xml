<?xml version="1.0" encoding="utf-8"?>
<!-- 拱券卡片的按下涟漪，蒙版与 an_card_arched 的主面同形。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/an_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners
                android:bottomLeftRadius="@dimen/an_radius_s"
                android:bottomRightRadius="@dimen/an_radius_l"
                android:topLeftRadius="@dimen/an_radius_arch"
                android:topRightRadius="@dimen/an_radius_arch" />
        </shape>
    </item>
</ripple>
