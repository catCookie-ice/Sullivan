<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 尺寸令牌：新艺术风格里「疏」比「密」重要，间距整体比 Material 默认大一档。 -->
    <dimen name="an_space_xs">4dp</dimen>
    <dimen name="an_space_s">8dp</dimen>
    <dimen name="an_space_m">16dp</dimen>
    <dimen name="an_space_l">24dp</dimen>
    <dimen name="an_space_xl">32dp</dimen>

    <!-- 非对称圆角：左上最夸张，右下略收，形成「手绘的方」 -->
    <dimen name="an_radius_xs">6dp</dimen>
    <dimen name="an_radius_s">12dp</dimen>
    <dimen name="an_radius_m">20dp</dimen>
    <dimen name="an_radius_l">28dp</dimen>
    <dimen name="an_radius_arch">96dp</dimen>

    <dimen name="an_stroke">1.5dp</dimen>
    <dimen name="an_stroke_hair">1dp</dimen>

    <!-- 触控目标下限：低视力用户靠 TalkBack 逐个聚焦，48dp 是硬底线 -->
    <dimen name="an_touch_min">48dp</dimen>
    <dimen name="an_button_height">56dp</dimen>

    <dimen name="an_text_display">30sp</dimen>
    <dimen name="an_text_title">22sp</dimen>
    <dimen name="an_text_section">17sp</dimen>
    <dimen name="an_text_body">17sp</dimen>
    <dimen name="an_text_label">13sp</dimen>
</resources>
