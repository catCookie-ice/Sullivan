<?xml version="1.0" encoding="utf-8"?>
<!--
    新艺术运动风的文字与控件样式。

    <b>字体只有衬线/无衬线之别，没有自带字库</b>：工程刻意不把 .ttf 打进 APK
    （体积 + 授权都是问题），标题用系统自带的 `serif`（Noto Serif，中文回退到系统衬线），
    正文保持无衬线 —— 受护人端是低视力优先，正文衬线在小字号下反而更难读。
    以后若要换字体，把 .ttf 放进 res/font/，只改这几个 TextAppearance 的 fontFamily 一处。

    <b>字距（letterSpacing）是这套风格的主要手法</b>：新艺术运动的海报标题普遍拉得很开，
    在没有装饰字库的前提下，靠 0.04~0.14 的 letterSpacing 就能拉开与 Material 默认的差距。

    <b>按钮为什么不用自绘 drawable</b>：MaterialComponents 主题下 `<Button>` 会被
    MaterialComponentsViewInflater 换成 MaterialButton，而 MaterialButton 自己管背景，
    塞 android:background 是踩坑姿势。所以按钮一律走 MaterialButton 的
    backgroundTint / strokeColor / cornerRadius 三个属性，颜色由 res/color/ 下的
    ColorStateList 提供。代价是按钮四角只能同值 —— 有机轮廓交给卡片和装饰层去表达。
-->
<resources>

    <!-- ===== 文字样式 ===== -->
    <style name="TextAppearance.Sullivan.Display" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textSize">@dimen/an_text_display</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/an_ink</item>
    </style>

    <style name="TextAppearance.Sullivan.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">@dimen/an_text_title</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/an_ink</item>
    </style>

    <style name="TextAppearance.Sullivan.Section" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">@dimen/an_text_section</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/an_gold_deep</item>
    </style>

    <style name="TextAppearance.Sullivan.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/an_text_body</item>
        <item name="android:textColor">@color/an_ink_2</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Sullivan.Label" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">@dimen/an_text_label</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/an_ink_3</item>
    </style>

    <style name="TextAppearance.Sullivan.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">@dimen/an_text_label</item>
        <item name="android:textColor">@color/an_ink_3</item>
    </style>

    <!-- ===== 按钮 ===== -->
    <!--
        主按钮：古金面 + 墨色描边。
        文字用墨色而不是白色 —— 古金是中间调，白字对比度只有约 2.3:1，读不清；
        墨色压在古金上约 6.8:1，满足无障碍要求。
    -->
    <style name="Widget.Sullivan.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/an_button_tint</item>
        <item name="cornerRadius">@dimen/an_radius_s</item>
        <item name="strokeWidth">@dimen/an_stroke</item>
        <item name="strokeColor">@color/an_ink</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/an_touch_min</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/an_ink</item>
    </style>

    <style name="Widget.Sullivan.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">@dimen/an_radius_s</item>
        <item name="strokeWidth">@dimen/an_stroke</item>
        <item name="strokeColor">@color/an_outline_stroke</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/an_touch_min</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/an_gold_deep</item>
    </style>

    <!-- 透明按钮：标题栏右侧这类低频动作，保持 48dp 点击高度。 -->
    <style name="Widget.Sullivan.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/an_touch_min</item>
        <item name="android:minWidth">@dimen/an_touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/an_gold_deep</item>
        <item name="rippleColor">@color/an_ripple</item>
    </style>

    <!--
        CameraGhost / CameraOutline / Alarm 三套按钮样式（以及只被它们引用的
        an_camera_switch_thumb / an_camera_switch_track 两个 ColorStateList）
        只服务受护人的障碍检测页，已随该页拆到 client-android/client-protectee。
        本端的相机页只剩扫码页，它用的是通用样式 + Theme.Sullivan.Camera。
    -->

    <!-- ===== 卡片 ===== -->
    <!--
        卡片是「错位双框 + 不对称圆角」的 layer-list，不是 MaterialCardView：
        MaterialCardView 四角同值，做不出新艺术运动的有机轮廓。
        可点区域靠 foreground 里的涟漪，而涟漪必须在布局里把卡片的
        clickable/focusable 打开才生效 —— foreground 只在可点或可聚焦的 View 上显示。
    -->
    <!--
        parent="" 是必需的：不带 parent 时 aapt 会按名字里的点号推父样式，
        Widget.Sullivan.Card 会去找 Widget.Sullivan —— 那个样式并不存在，链接期直接报错。
    -->
    <style name="Widget.Sullivan.Card" parent="">
        <item name="android:background">@drawable/an_card</item>
        <item name="android:padding">@dimen/an_space_l</item>
        <item name="android:foreground">@drawable/an_card_press</item>
    </style>

    <style name="Widget.Sullivan.Card.Arched">
        <item name="android:background">@drawable/an_card_arched</item>
        <item name="android:foreground">@drawable/an_arch_press</item>
    </style>

    <style name="Widget.Sullivan.Card.Flat">
        <item name="android:background">@drawable/an_card_flat</item>
        <item name="android:padding">@dimen/an_space_m</item>
    </style>

    <!-- ===== 输入框 ===== -->
    <style name="Widget.Sullivan.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/an_field_stroke</item>
        <item name="boxStrokeWidth">@dimen/an_stroke_hair</item>
        <item name="boxStrokeWidthFocused">@dimen/an_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/an_radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/an_radius_xs</item>
        <item name="boxCornerRadiusBottomStart">@dimen/an_radius_xs</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/an_radius_s</item>
        <item name="hintTextColor">@color/an_ink_3</item>
        <item name="android:textColorHint">@color/an_ink_3</item>
    </style>

    <!-- ===== 状态标签 ===== -->
    <style name="Widget.Sullivan.Chip" parent="">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ===== 页面骨架 ===== -->
    <!-- 非相机页的根 ScrollView 用它：铺纸面底 + 统一页边距。 -->
    <style name="Widget.Sullivan.Page" parent="">
        <item name="android:background">@drawable/an_bg_page</item>
        <item name="android:fillViewport">true</item>
        <item name="android:paddingStart">@dimen/an_space_l</item>
        <item name="android:paddingEnd">@dimen/an_space_l</item>
        <item name="android:paddingTop">@dimen/an_space_xl</item>
        <item name="android:paddingBottom">@dimen/an_space_l</item>
        <item name="android:clipToPadding">false</item>
    </style>
</resources>
