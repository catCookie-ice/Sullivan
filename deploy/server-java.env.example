# =============================================================================
# server-java 运行时环境变量模板
#
# 怎么用：
#   cp deploy/server-java.env.example deploy/server-java.env
#   编辑 deploy/server-java.env（**这个文件不进仓库，已在 .gitignore 里**）
#   然后按下面任一方式加载（见文件末尾）。
#
# 重要：仓库里没有 dotenv 库，Spring Boot **不会**自动读取 .env 文件。
# 这个文件之所以有用，是因为 systemd 与 docker compose 都支持「从文件读环境变量」，
# 由它们在启动进程前把值注入进去。直接 `java -jar` 时它不会自己生效。
# =============================================================================

# ---------- 运行环境 ----------
APP_ENV=prod
SERVER_PORT=8642

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://127.0.0.1:3306/sullivan?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=sullivan
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 必须换成足够长的随机值。生成：openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=1800

# ---------- 媒体对象存储 ----------
# filesystem（开发默认）| cos（腾讯云，部署用）| minio（自建）
MEDIA_STORE=cos
MEDIA_ROOT=./data/media

# 腾讯云 COS。桶必须**私有**；bucket 必须带 APPID 后缀。
# 建议用只授权本桶某个前缀的子账号密钥，不要用主账号密钥。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
# 业务对象键的前缀（如 a）。留空则写在桶根下。
COS_PREFIX=

# 自建 MinIO（MEDIA_STORE=minio 时用）
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=sullivan-media

# ---------- 语音留言限额 ----------
VOICE_MESSAGE_MAX_DURATION_MS=60000
VOICE_MESSAGE_MAX_SIZE_BYTES=1048576
VOICE_MESSAGE_MAX_PER_DAY=50

# ---------- WebRTC ----------
# 只配 STUN 时同网段可通话、跨网不通（客户端会如实提示，不假装已接通）。
# 配了 TURN 地址就必须同时配 WEBRTC_TURN_SECRET，否则客户端会拿到必然鉴权失败的地址。
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=
WEBRTC_CREDENTIAL_TTL_SECONDS=3600

# ---------- 首次启动的管理员引导（只在库里没有管理员时生效）----------
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# ---------- 其它 ----------
QR_BIND_CODE_TTL_SECONDS=300
QR_LOGIN_TICKET_TTL_SECONDS=120
VOLUNTEER_MIN_REGISTRATION_DAYS=90

# =============================================================================
# 三种加载方式（任选其一）
#
# 1) Linux + systemd（推荐用于生产）
#    sudo cp deploy/server-java.env /etc/sullivan/server.env
#    sudo chmod 600 /etc/sullivan/server.env
#    systemd unit 里写：EnvironmentFile=/etc/sullivan/server.env
#
# 2) Docker Compose
#    在 compose 的服务段用：env_file: [./deploy/server-java.env]
#
# 3) 手工前台运行（开发调试）
#    set -a; . ./deploy/server-java.env; set +a
#    java -jar server-java/target/server-java-0.0.1-SNAPSHOT.jar
#    PowerShell 等价写法见 README 对应小节。
# =============================================================================
