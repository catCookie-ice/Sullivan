# 环境与密钥
.env
# 后端运行时环境变量（含 COS 密钥等），只提交 .example 模板
deploy/server-java.env
*.pem
*.key
*.jks
*.keystore
local.properties

# Java
target/
build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
HELP.md
server-java/server-java/.mvn/wrapper/maven-wrapper.jar

# 模型产物（体积大，不入库）。受护人端（client-android/client-protectee）
# 在 assets/ 本地放置 yolo26n.onnx / yolo26n-depth.onnx 供端侧 ONNX Runtime 使用
*.onnx

# Node
node_modules/
dist/
.vite/

# 前端本地联调产物（tools/ 下脚本生成的运行配置含真实 JWT，截图含账号数据，均不入库）
client-web/tools/*.run.json
client-web/tools/*.i18n.json
# e2e-admin.json 含真实 superadmin 密码，与 .env 同级敏感，永不入库
client-web/tools/e2e-admin.json
# 名字带 PASS 的本地便签（疑似口令记录位），一律不入库
0PASS.txt
client-web/.shots/

# Android（两个独立工程：监护人端 client-guardian，受护人端 client-protectee）
client-android/client-guardian/.idea/
client-android/client-guardian/app/release/
client-android/client-protectee/.idea/
client-android/client-protectee/app/release/
*.apk
*.aab

# IDE
.idea/
.vscode/
*.iml

# 运行时数据
deploy/data/
logs/
*.log
# 语音留言音频默认落在 app.media.root=./data/media（本地文件系统存储），不入库
server-java/server-java/data/

# OS
.DS_Store
Thumbs.db

# 本地个人记录
个人日记(AI工具排除此文件夹)/

# 参考项目（本地参考材料，不入库；其端侧检测资产已移植进 client-android/client-protectee/）
参考1/

# 构建期临时缓存（如 node 编译缓存），不入库
.tmp/
