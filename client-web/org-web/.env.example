# 复制为 .env 后填写。.env 不入库。

# 高德地图 JS API Key（创建志愿活动选点用；未配置时地图组件给出提示）
# 申请地址：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=

# 高德地图 JS API 安全密钥（securityJsCode）。JS API 2.0 自 2021-12-02 起强制要求：
# 未配置时地图加载/选点会报 INVALID_USER_SCODE，无法使用。在控制台「应用管理→我的应用→
# 添加 Key（Web端(JS API)）」处与 Key 配套生成。
VITE_AMAP_SECURITY_CODE=
