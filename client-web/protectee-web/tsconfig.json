{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      // 共享包（../shared）位于本应用 node_modules 之外，bare import 无法向上解析，
      // 此处显式映射到本应用的依赖类型入口。
      "vue": [
        "./node_modules/vue/dist/vue.d.ts"
      ],
      "vue-router": [
        "./node_modules/vue-router/dist/vue-router.d.mts"
      ],
      "element-plus": [
        "./node_modules/element-plus/es/index.d.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../shared/**/*.ts",
    "../shared/**/*.vue"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
